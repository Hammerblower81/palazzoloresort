---
import { Image } from "astro:assets";
import Layout from "./Layout.astro";
import Reviews from "./Reviews.astro";
import { type Language } from "../data/site";
import { pathFor } from "../data/pages";
import pool from "../assets/piscina.jpg";
import house from "../assets/casolare.jpg";
import kitchen from "../assets/camera.jpg";
import bath from "../assets/bagno-falegname.jpg";
import garden from "../assets/giardino.jpg";
import village from "../assets/anghiari-borgo.jpg";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const it = lang === "it";
---

<Layout lang={lang}>
  <section class="hero" aria-labelledby="hero-title">
    <Image
      class="hero-image"
      src={pool}
      alt={
        it
          ? "La piscina privata di Palazzolo affacciata sulle colline"
          : "Palazzolo private pool overlooking the hills"
      }
      widths={[640, 960, 1440, 1920, 2560]}
      sizes="100vw"
      format="webp"
      quality={85}
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-shade"></div>
    <div class="hero-content">
      <p class="eyebrow">ANGHIARI · TOSCANA</p>
      <h1 id="hero-title">
        {it ? "La vostra casa" : "Your Tuscan"}
        <br />
        <em>{it ? "in Toscana." : "home."}</em>
      </h1>
      <p class="hero-exclusive">
        {it
          ? "Un solo gruppo. Tutto Palazzolo per voi."
          : "One group. All of Palazzolo to yourselves."}
      </p>
      <p class="hero-description">
        {it
          ? "Quattro camere, quattro bagni. Piscina, giardino e casolare riservati in esclusiva per tutta la durata del soggiorno."
          : "Four bedrooms, four bathrooms. The pool, garden and farmhouse are exclusively yours throughout your stay."}
      </p>
      <div class="hero-links">
        <a class="button button-light" href={pathFor(lang, "house")}>
          {it ? "Entrate nel casolare" : "Explore the farmhouse"} ↗
        </a>
        <a href={pathFor(lang, "contact")}>
          {it ? "Chiedi disponibilità" : "Ask about availability"} ↗
        </a>
      </div>
    </div>
    <span class="hero-bottom-note">
      {it
        ? "UNA CASA DI FAMIGLIA, UN SOGGIORNO TUTTO VOSTRO"
        : "A FAMILY HOME, A STAY ALL YOUR OWN"}
    </span>
  </section>
  <div class="facts">
    {(it
      ? [
          ["01", "Gruppo alla volta"],
          ["04", "Camere"],
          ["04", "Bagni"],
          ["100%", "Piscina e giardino privati"],
        ]
      : [
          ["01", "Group at a time"],
          ["04", "Bedrooms"],
          ["04", "Bathrooms"],
          ["100%", "Private pool and garden"],
        ]
    ).map(([n, label]) => (
      <div>
        <strong>{n}</strong>
        <span>{label}</span>
      </div>
    ))}
  </div>
  <section class="editorial section-wrap" id="casolare">
    <div class="editorial-copy">
      <p class="eyebrow">
        {it ? "IL CARATTERE DI UNA CASA VERA" : "A HOME WITH CHARACTER"}
      </p>
      <h2>
        {it ? "Una storia di famiglia." : "A family story."}
        <br />
        <em>{it ? "Un posto per la vostra." : "A place for yours."}</em>
      </h2>
      <p class="lead">
        {it
          ? "La pietra del casolare, il legno degli arredi, le colline di Anghiari. Palazzolo è la casa dei nostri nonni, restaurata per accogliere nuovi ricordi."
          : "Farmhouse stone, wooden furniture, the hills of Anghiari. Palazzolo is our grandparents’ home, restored to welcome new memories."}
      </p>
      <p>
        {it
          ? "Gli ambienti conservano le tracce della casa di un tempo e le incontrano con dettagli contemporanei. Qui potete ritrovarvi a tavola, fermarvi in giardino o partire alla scoperta della Toscana. Con la libertà di avere l’intera struttura a vostra disposizione."
          : "Original features sit alongside contemporary details. Gather around the table, linger in the garden or set out to explore Tuscany, with the freedom of having the entire property to yourselves."}
      </p>
      <a class="text-link" href={pathFor(lang, "house")}>
        {it
          ? "Scoprite la casa e le camere"
          : "Discover the house and bedrooms"}{" "}
        ↗
      </a>
    </div>
    <figure class="editorial-photo">
      <Image
        src={house}
        alt={
          it
            ? "Il casolare in pietra tra alberi e campi"
            : "The stone farmhouse among trees and fields"
        }
        widths={[640, 960, 1440]}
        sizes="(max-width:800px) 100vw, 48vw"
        format="webp"
      />
      <figcaption>PALAZZOLO · ANGHIARI</figcaption>
    </figure>
  </section>
  <section class="interior-story section-wrap" id="interni">
    <div class="section-heading">
      <div>
        <p class="eyebrow">
          {it ? "IL RESTAURO, NEI DETTAGLI" : "A RESTORATION IN THE DETAILS"}
        </p>
        <h2>
          {it ? "Dentro, una personalità" : "Inside, a character"}
          <br />
          <em>{it ? "che non si dimentica." : "to remember."}</em>
        </h2>
      </div>
      <p>
        {it
          ? "Un banco da falegname che diventa il piano dei lavabi. La cucina contemporanea tra le pareti in pietra. Oggetti recuperati, materiali autentici e scelte che rendono ogni ambiente diverso."
          : "A carpenter’s workbench becomes a vanity for bowl basins. A contemporary kitchen between stone walls. Reclaimed furniture, honest materials and thoughtful details give each room its own character."}
      </p>
    </div>
    <div class="interior-duo">
      <a href={`${pathFor(lang, "house")}#bagni`}>
        <Image
          src={bath}
          alt={
            it
              ? "Il bagno con due lavabi a ciotola sul banco da falegname"
              : "Bathroom with two bowl basins on a carpenter’s workbench"
          }
          widths={[640, 960, 1400]}
          sizes="(max-width:800px) 100vw, 55vw"
          format="webp"
        />
        <span>
          {it
            ? "Il banco da falegname, una nuova vita"
            : "The workbench, a new life"}{" "}
          ↗
        </span>
      </a>
      <a href={pathFor(lang, "house")}>
        <Image
          src={kitchen}
          alt={
            it
              ? "La cucina contemporanea con isola e pareti in pietra"
              : "Contemporary kitchen with an island and stone walls"
          }
          widths={[480, 800, 1200]}
          sizes="(max-width:800px) 100vw, 36vw"
          format="webp"
        />
        <span>
          {it
            ? "La cucina, al centro della casa"
            : "The kitchen, at the heart of the home"}{" "}
          ↗
        </span>
      </a>
    </div>
    <a class="text-link" href={pathFor(lang, "gallery")}>
      {it ? "Tutte le fotografie" : "All photographs"} ↗
    </a>
  </section>
  <section class="outdoor-story">
    <div class="outdoor-image">
      <Image
        src={garden}
        alt={
          it
            ? "Il pergolato e il giardino riservati agli ospiti"
            : "The pergola and garden reserved for guests"
        }
        widths={[640, 960, 1600]}
        sizes="(max-width:800px) 100vw, 55vw"
        format="webp"
      />
    </div>
    <div class="outdoor-copy">
      <p class="eyebrow">
        {it ? "FUORI, SOLO IL VOSTRO RITMO" : "OUTSIDE, AT YOUR OWN PACE"}
      </p>
      <h2>
        {it ? "La piscina. Il verde." : "The pool. The garden."}
        <br />
        <em>{it ? "La vostra tranquillità." : "Your own quiet corner."}</em>
      </h2>
      <p>
        {it
          ? "Un tuffo, un libro all’ombra, una cena che si allunga. Piscina, giardino e veranda sono riservati soltanto al gruppo che soggiorna: non accogliamo altri ospiti nello stesso periodo."
          : "A swim, a book in the shade, an evening around the table. The pool, garden and veranda are reserved for your group: we do not host other guests during your stay."}
      </p>
      <a class="text-link" href={`${pathFor(lang, "house")}#piscina`}>
        {it ? "Gli spazi all’aperto" : "Explore the outdoor spaces"} ↗
      </a>
    </div>
  </section>
  <section class="territory-preview section-wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{it ? "OLTRE IL CANCELLO" : "BEYOND THE GATE"}</p>
        <h2>
          {it ? "Una Toscana" : "A Tuscany"}
          <br />
          <em>{it ? "da vivere, fuori." : "to explore."}</em>
        </h2>
      </div>
      <p>
        {it
          ? "A piedi o in bicicletta, tra vigna e olivi. E poi Anghiari, con i suoi vicoli e la valle che si apre sotto il borgo. La vacanza continua appena fuori casa."
          : "On foot or by bicycle, among vines and olive trees. Then Anghiari, its stone lanes and the valley below. Your holiday continues just beyond the house."}
      </p>
    </div>
    <a class="landscape-link" href={pathFor(lang, "experiences")}>
      <Image
        src={village}
        alt={
          it ? "Il borgo di Anghiari al calare della sera" : "Anghiari at dusk"
        }
        widths={[640, 960, 1440]}
        sizes="90vw"
        format="webp"
      />
      <span>
        ANGHIARI · VALTIBERINA <b>↗</b>
      </span>
    </a>
    <div class="experience-tags">
      <span>{it ? "Passeggiate" : "Walking"}</span>
      <span>{it ? "Bicicletta" : "Cycling"}</span>
      <span>{it ? "Borghi e cultura" : "Villages and culture"}</span>
      <span>{it ? "Vigna e olivi" : "Vines and olive trees"}</span>
    </div>
    <a class="text-link" href={pathFor(lang, "experiences")}>
      {it
        ? "Esplorate le esperienze e il territorio"
        : "Explore experiences and the area"}{" "}
      ↗
    </a>
  </section>
  <Reviews lang={lang} compact />
  <section class="faq section-wrap">
    <div>
      <p class="eyebrow">
        {it ? "LE RISPOSTE, SUBITO" : "A FEW USEFUL ANSWERS"}
      </p>
      <h2>{it ? "Prima di partire." : "Before your stay."}</h2>
    </div>
    <div class="faq-list">
      {(it
        ? [
            [
              "La piscina e il giardino sono privati?",
              "Sì. Casa, piscina, giardino e veranda sono a uso esclusivo del vostro gruppo per tutta la durata del soggiorno. Non sono presenti altri gruppi di ospiti.",
            ],
            [
              "Si possono prenotare le singole camere?",
              "Il soggiorno riguarda l’intero casolare: le quattro camere e i quattro bagni sono parte di un’unica struttura riservata a chi prenota.",
            ],
            [
              "Come chiediamo disponibilità?",
              "Scriveteci su WhatsApp o via email indicando date e composizione del gruppo. Potete anche consultare l’annuncio su Airbnb o Booking.com.",
            ],
          ]
        : [
            [
              "Are the pool and garden private?",
              "Yes. The house, pool, garden and veranda are exclusively for your group throughout your stay. No other groups of guests stay at the same time.",
            ],
            [
              "Can we book individual bedrooms?",
              "Bookings are for the whole farmhouse. Its four bedrooms and four bathrooms are part of a single property reserved for your group.",
            ],
            [
              "How can we check availability?",
              "Send us your dates and group details by WhatsApp or email. You can also view the listing on Airbnb or Booking.com.",
            ],
          ]
      ).map(([q, a]) => (
        <details>
          <summary>
            {q}
            <span aria-hidden="true">+</span>
          </summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
