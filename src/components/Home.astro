---
import { Image } from 'astro:assets';
import { copy, site, type Language } from '../data/site';
import '../styles/site.css';
import pool from '../assets/piscina.jpg';
import house from '../assets/casolare.jpg';
import kitchen from '../assets/camera.jpg';
import veranda from '../assets/veranda.jpg';
import garden from '../assets/giardino.jpg';
import village from '../assets/anghiari.jpg';
import suite from '../assets/suite.jpg';
import bedroom from '../assets/barbolana.jpg';

interface Props { lang: Language }
const { lang } = Astro.props;
const t = copy[lang];
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const canonical = new URL(lang === 'it' ? '/' : '/en/', Astro.site);
const sections = ['casolare', 'vita', 'territorio', 'contatti'];
const experienceImages = [pool, veranda, garden];
const whatsapp = `${site.whatsapp}?text=${encodeURIComponent(lang === 'it' ? 'Ciao! Vorrei informazioni per un soggiorno a Palazzolo Resort.' : 'Hello! I would like to ask about a stay at Palazzolo Resort.')}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f2ea" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="robots" content={indexable ? 'index,follow,max-image-preview:large' : 'noindex,nofollow'} />
    {indexable && <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="it" href={new URL('/', Astro.site)} />
      <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    </>}
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta property="og:image" content={new URL(pool.src, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body id="inizio">
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <a class="brand" href={lang === 'it' ? '/' : '/en/'} aria-label="Palazzolo Resort — home">
        <span class="brand-name">palazzolo<span class="brand-star" aria-hidden="true">✳</span></span>
        <span class="brand-sub">RESORT · TOSCANA</span>
      </a>
      <nav class="desktop-nav" aria-label={lang === 'it' ? 'Navigazione principale' : 'Main navigation'}>
        {t.nav.slice(0, 3).map((label, i) => <a href={`#${sections[i]}`}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <nav class="language-nav" aria-label={lang === 'it' ? 'Lingua' : 'Language'}>
          <a href="/" lang="it" hreflang="it" aria-current={lang === 'it' ? 'page' : undefined}>IT</a>
          <span aria-hidden="true">/</span>
          <a href="/en/" lang="en" hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
        </nav>
        <a class="header-contact" href="#contatti">{t.contact}<span aria-hidden="true">↗</span></a>
        <details class="mobile-menu">
          <summary aria-label={t.menu}><span></span><span></span></summary>
          <nav aria-label={lang === 'it' ? 'Menu mobile' : 'Mobile menu'}>
            {t.nav.map((label, i) => <a href={`#${sections[i]}`}>{label}</a>)}
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <Image class="hero-image" src={pool} alt={t.experiences[0].alt} widths={[640, 960, 1440, 1920, 2560]} sizes="100vw" format="webp" quality={85} loading="eager" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="hero-top"><span class="eyebrow">{t.eyebrow}</span><span class="hero-coordinate">{lang === 'it' ? 'IL CASOLARE, TUTTO PER VOI' : 'THE FARMHOUSE, ALL YOURS'}</span></div>
        <div class="hero-content">
          <h1 id="hero-title">{t.hero1}<br /><em>{t.hero2}</em></h1>
          <div class="hero-bottom"><p>{t.heroText}</p><a class="round-link" href="#casolare"><span>{t.heroCta}</span><span class="round-icon" aria-hidden="true">↓</span></a></div>
        </div>
        <span class="hero-side" aria-hidden="true">PALAZZOLO RESORT — ANGHIARI</span>
      </section>

      <div class="facts" aria-label={lang === 'it' ? 'Il casolare in breve' : 'The farmhouse at a glance'}>
        {t.facts.map(([value, label]) => <div class="fact"><span class="fact-value">{value}</span><span>{label}</span></div>)}
      </div>

      <section class="intro section-wrap" id="casolare" aria-labelledby="intro-title">
        <div class="intro-copy">
          <p class="eyebrow olive">{t.introLabel}</p>
          <h2 id="intro-title" class="line-title">{t.introTitle}</h2>
          <p class="body-large">{t.introText}</p><p>{t.introText2}</p>
          <a class="text-link" href="#contatti">{t.introLink}<span aria-hidden="true">↗</span></a>
        </div>
        <figure class="intro-figure">
          <Image src={house} alt={t.houseAlt} widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 48vw" format="webp" loading="lazy" />
          <figcaption><span>PALAZZOLO</span><span>{lang === 'it' ? 'Una storia di famiglia' : 'A family story'}</span></figcaption>
          <span class="image-seal" aria-hidden="true">TOSCANA<br /><i>con amore</i><br />ANGHIARI</span>
        </figure>
      </section>

      <section class="spaces section-wrap" aria-labelledby="spaces-title">
        <div class="section-heading"><div><p class="eyebrow olive">{t.detailLabel}</p><h2 id="spaces-title" class="line-title">{t.detailTitle}</h2></div><p>{t.detailText}</p></div>
        <div class="spaces-grid">
          <figure class="kitchen-photo"><Image src={kitchen} alt={t.kitchenAlt} widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 58vw" format="webp" loading="lazy" /></figure>
          <div class="bedrooms"><div class="bedroom-images"><Image src={suite} alt={t.suiteAlt} widths={[320, 640]} sizes="(max-width: 760px) 44vw, 18vw" format="webp" loading="lazy" /><Image src={bedroom} alt={t.roomAlt} widths={[320, 640]} sizes="(max-width: 760px) 44vw, 18vw" format="webp" loading="lazy" /></div><div class="bedrooms-copy"><span class="tiny-label">SUITE · BARBOLANA · CAMERA DEI NONNI · SUPERIOR</span><h3>{t.roomLabel}</h3><p>{t.roomText}</p></div></div>
        </div>
      </section>

      <section class="life" id="vita" aria-labelledby="life-title"><div class="section-wrap">
        <div class="section-heading"><div><p class="eyebrow olive">{t.lifeLabel}</p><h2 id="life-title" class="line-title">{t.lifeTitle}</h2></div><span class="sun-mark" aria-hidden="true">☼</span></div>
        <div class="experience-grid">{t.experiences.map((item, i) => <article class="experience"><div class="experience-photo"><Image src={experienceImages[i]} alt={item.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 31vw" format="webp" loading="lazy" /></div><div class="experience-title"><span>{item.number}</span><h3>{item.title}</h3></div><p>{item.text}</p></article>)}</div>
      </div></section>

      <section class="manifesto" aria-label={t.quoteLabel}><span class="botanical" aria-hidden="true">✳</span><p class="eyebrow">{t.quoteLabel}</p><p class="manifesto-quote line-title">{t.quote}</p><span class="manifesto-sign">Palazzolo Resort</span></section>

      <section class="location section-wrap" id="territorio" aria-labelledby="location-title"><div class="location-image"><Image src={village} alt={t.locationAlt} widths={[640, 1038]} sizes="(max-width: 760px) 100vw, 48vw" format="webp" loading="lazy" /></div><div class="location-copy"><p class="eyebrow olive">{t.locationLabel}</p><h2 id="location-title" class="line-title">{t.locationTitle}</h2><p>{t.locationText}</p><div class="location-address"><span class="pin" aria-hidden="true">⌖</span><div><strong>Palazzolo Resort</strong><br />Via Tavernelle, 14<br />52031 Anghiari · Arezzo</div></div><a class="text-link" href={site.maps} target="_blank" rel="noopener noreferrer">{t.mapCta}<span aria-hidden="true">↗</span></a></div></section>

      <section class="faq section-wrap" aria-labelledby="faq-title"><div><p class="eyebrow olive">{t.faqLabel}</p><h2 id="faq-title">{t.faqTitle}</h2></div><div class="faq-list">{t.faqs.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>

      <section class="contact-section" id="contatti" aria-labelledby="contact-title"><div class="section-wrap contact-inner"><p class="eyebrow">{t.bookingLabel}</p><h2 id="contact-title" class="line-title">{t.bookingTitle}</h2><p>{t.bookingText}</p><div class="contact-buttons"><a class="button button-light" href={whatsapp} target="_blank" rel="noopener noreferrer">{t.whatsapp}<span aria-hidden="true">↗</span></a><a class="button button-outline" href={`mailto:${site.email}`}>{t.email}<span aria-hidden="true">↗</span></a></div><div class="platforms"><span>{t.platforms}</span><div><a href={site.airbnb} target="_blank" rel="noopener noreferrer">Airbnb <span aria-hidden="true">↗</span></a><a href={site.booking} target="_blank" rel="noopener noreferrer">Booking.com <span aria-hidden="true">↗</span></a></div></div></div><span class="contact-decoration" aria-hidden="true">P</span></section>
    </main>

    <footer class="site-footer section-wrap"><div class="footer-top"><div><a class="brand footer-brand" href={lang === 'it' ? '/' : '/en/'}><span class="brand-name">palazzolo<span class="brand-star" aria-hidden="true">✳</span></span><span class="brand-sub">RESORT · TOSCANA</span></a><p>{t.footerText}</p></div><address>Via Tavernelle, 14<br />52031 Anghiari (AR), Italia<br /><a href={site.maps} target="_blank" rel="noopener noreferrer">{t.directions} ↗</a></address><div class="footer-contacts"><a href={`mailto:${site.email}`}>{site.email}</a><a href={`tel:${site.phoneHref}`}>{site.phone}</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Palazzolo Resort</span><a href="https://www.palazzoloresort.it/terms-and-conditions/" target="_blank" rel="noopener noreferrer">{t.terms} ↗</a><a href="#inizio">{t.back} ↑</a></div></footer>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
      document.addEventListener('click', event => { if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
    </script>
  </body>
</html>
